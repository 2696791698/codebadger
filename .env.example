# Configuration is now centralized in src/defaults.py
# Override defaults by modifying config.yaml or setting environment variables
# main.py also auto-loads a project-root .env file if present.
#
# For more control, edit config.yaml directly or set these env vars:
# - MCP_HOST, MCP_PORT, MCP_LOG_LEVEL
# - JOERN_BINARY_PATH, JOERN_MEMORY_LIMIT, JOERN_JAVA_OPTS, JOERN_SERVER_STARTUP_TIMEOUT
# - JOERN_PORT_MIN, JOERN_PORT_MAX
# - CPG_GENERATION_TIMEOUT, MAX_REPO_SIZE_MB
# - QUERY_TIMEOUT, QUERY_CACHE_ENABLED, QUERY_CACHE_TTL
# - WORKSPACE_ROOT, CLEANUP_ON_SHUTDOWN

# Docker port mapping
# Container-side Joern ports must match JOERN_PORT_MIN / JOERN_PORT_MAX used by the app.
# Host-side ports can be changed independently to avoid local conflicts.
JOERN_HOST_PORT_MIN=13371
JOERN_HOST_PORT_MAX=13870

# Docker Configuration
# Note: Joern is built locally as codebadger-joern-server:latest via docker-compose
DOCKER_HOST=unix:///var/run/docker.sock

# GitHub (optional)
GITHUB_TOKEN=

